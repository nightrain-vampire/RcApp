.container{
    text-align: center;
    border-bottom: 20rpx solid #d5e7e4;
    color: #999;
    line-height: 90rpx;
    font-size: 28rpx;
}

.recommend-bg {
    background-image: url(https://pic.imgdb.cn/item/625a6e9f239250f7c5993dca.png);
    width:100%;
    height:100vh;
    /* height: 100%; */
    background-size: 100% 100%;  
}

.name-area {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-top: 12vh;
}

.name_bimg {
    height: 15vh;
    width: 93%;
}

.name_input_bimg{
    position: absolute;
    top:256rpx;
    text-align: right;
    font-size: medium;
}

/* .input-area{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-top: 30px;
} */

.reason-area{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-top: 75px;
}

.reason_bimg {
    position:absolute;
}

.photo_upload-area{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* padding-top: 21.5vh; */
    padding-top: 70.6px;
}

.photo_upload_bg_bimg{
    display:flex;
    height: 136px;
    width: 356px;
    /* width: 93%; */
}

.photo_upload_bimg{
    position: absolute;
}

.info-area{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-top: 69px;
}

.info_bimg {
    position:absolute;
}

.button-area {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* padding-top: 1px; */
    padding-top: 73px;
}

.button_bimg {
    width: 52%;
    height: 100px;
}




.Rform{
    text-align: left;
    padding: 0;
    align-items: left;
    /* padding-left: 15rpx; */
    position: absolute;
    /* top: 13%; */
    top:42%;
    left: 6%;
    /* background-color: #FdFdFd; */
    background-color: transparent;
    width: 85%;
    /* height: 83%; */
    height: 5%;
    border-radius:5rpx;
    /* box-shadow: 0px 0px 8rpx #888888; */
    font-size: 10rpx;
}
.lineHeight {
    width: 90%;
    line-height: 55rpx;
    margin-left: 5%;
    padding-top: 5%;
}
.lineHeight2{
    width: 90%;
    line-height: 55rpx;
    margin-left: 5%;
    padding-top: 5%;
}
.input{
    margin-left: 20rpx;
    display: inline-block;
    line-height: 80rpx;
    vertical-align: middle;
    width: 60%;
    border: 15rpx solid #D5D5D5;
    /* background-color: white; */
    background-color: transparent;
    border-radius: 10rpx;
    padding-left: 10rpx;
}
.area{
    height: 200rpx;
    position: relative;
    width: 90%;
    border: 15rpx solid #ccc;
    border-radius: 35rpx;
    /* background-color: white; */
    background-color: transparent;
    padding-left: 25rpx;
}
.btns {
    position: absolute;
    width: 90%;
    top: 90%;
    left: 5%;
    align-items: center;
    justify-content: center;
    display: flex;
    background-color: transparent;
}


.clear{
    color: grey;
}
.clear:hover {
    color: #69207e; 
    text-decoration: underline;
}