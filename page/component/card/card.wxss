page{
  background-color: #fff
}
.mine-container{
	  /* margin-bottom:60rpx; */
    background-color: #fff;
    border-bottom: 2rpx solid #dbdbdb;
    border-top: 2rpx solid #dbdbdb;
}

.user-photo{
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 50rpx 30rpx;
  background-color: #fff;
  border-bottom: 2rpx solid #dbdbdb;
}
.user-photo text{
	font-size: 20rpx;
	margin-top: 8rpx;
	color: #666
}
.user-photo image{
	width: 100rpx;
    height: 100rpx;
	border-radius: 100%;
    border: 2px solid rgba(221, 221, 221, 0.81);
}
.survey-total{
	font-size: 28rpx;
	margin-top: 20rpx;
	color: #666
}
.survey-total text{
	font-size: 32rpx;
	color: #5f1971;
}
.height{
	height: 10rpx;
	background-color: #e5e9f2;
	width: 100%;
}
.mine-item{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 28rpx 20rpx;
  border-bottom: 2rpx solid #dbdbdb;
  font-size: 34rpx;
}
.mine-item:last-child{
  margin-bottom: 0rpx;
  border-bottom:none;
}
.mine-item text{
  padding-left: 20rpx;
  text-align: left;
  flex: 1
}
.mine-item:active{
  background-color: #eee;
}
.mine-item image:first-child{
  width: 54rpx;
  height: 54rpx;
}
.mine-item image:last-child{
  width: 32rpx;
  height: 32rpx;
  padding-right: 20rpx;
}

.user-photo wx-image {
  width:120rpx;
  height:120rpx;
  border-radius:0;
  border:none;
}
.mine-container{
  margin-bottom: 0;
}
.user-photo text {
  font-size: 30rpx;
  color: #333;
}
.survey-total{
  line-height: 1.5;
}
.survey-total.top{
  padding-left: 20rpx;
  color:rgb(237, 85, 101);
}
.mine-item button{
  flex: 1;
  text-align: left;
  border: none;
  padding-left:20rpx;
  margin: 0;
  background-color: transparent;
  font-size: 34rpx;
}
.mine-item text{
  color: #666
}
.mine-item button:after{
  width: 0;height: 0;
}
.mine-item image:first-child {
  background-color: rgba(95, 25, 113, 0.8);
  padding: 10rpx;
  border-radius: 100%;
}