.avatar {
    width: 180rpx;
    height: 180rpx;
    border-radius: 50rpx;
    padding-right: 10rpx;
}

.userArea {
    display: flex;
    flex-direction: row;
    align-items: bottom;
    padding: 50rpx 60rpx;
    transform: translateX(25rpx) translateY(10rpx);
}

.infArea {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: left;
    padding: 10rpx 10rpx;
}

.un {
    font-size: xx-large;
    color: white;
    font-weight: bold;
}

.un2 {
    font-size: large;
    color: #c2b4b4d0;
}

.divLine {
    width: 360rpx;
    height: 120rpx;
    display: flex;
    margin-bottom: 60rpx;
}

.cardArea {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    align-items: center;
}

.card-info {
    flex-shrink: 0;
    box-sizing: border-box;
    width: 675rpx;
    height: 500rpx;
    margin-bottom: 20px;
    background-color: #FdFdFd;
    /* border-radius:15rpx; */
    box-shadow: 0px 0px 8rpx #888888;
    font-size: 26rpx;
}

.picArea{
    position: relative;
    width: auto;
    height: 420rpx;
}

.smove {
    height: 0;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 0 25rpx;
    transform: translateY(-260rpx);
}

.controlview {
    width: 80rpx;
    height: 80rpx;
}

.controlimg {
    width: 100%;
    height: 100%;
}

.sitem {
    height: 100%;
}

.bottomArea {
    padding: 20rpx;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.infname {
    float: left;
}

.infdetail {
    border: 4rpx solid darkgray;
    border-radius: 0.8em;
    padding: 10rpx 15rpx;
    font-size: small;
    color: darkgray;
    transform: translateY(-12rpx);
}