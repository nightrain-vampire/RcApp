<view class="main">
  <loading wx-if="{{loading}}" />
    <view class="head-bg">
        <view class="userArea">
            <view class="avatar">
                <image src="{{avatar}}" style="width: 100%; height: 100%;"></image>
            </view>
            <view class="infArea">
                <view class="un">{{username}}</view>
                <view class="un2">{{uid}}</view>
            </view>
        </view>
        <view class="divLine">
            <image src="../../static/myvotetitle.png" style="width: 100%; height: 100%;"></image>
        </view>
        <view class="cardArea">
            <view wx:for="{{cardData}}" wx:for-index="cid">
                <view class="card-info">
                    <view class="picArea">
                        <swiper class="sitem" current="{{currentIndex[cid]}}" bindanimationfinish="changeFinish" id="{{cid}}">
                            <swiper-item wx:for="{{item.img}}" wx:for-item="img" catchtouchmove="stopTouchMove">
                                <image src='{{img}}' mode="aspectFill" style="height: 100%; width: 100%;"></image>
                            </swiper-item>
                        </swiper>
                        <view class="smove">
                            <view class="controlview">
                                <image wx:if="{{LeftShow[cid]}}" src="../../static/left.png" class="controlimg" id="{{cid}}" bindtap="toLeft"></image>
                            </view>
                            <view class="controlview">
                                <image wx:if="{{RightShow[cid]}}" src="../../static/right.png" class="controlimg" id="{{cid}}" bindtap="toRight"></image>
                            </view>
                        </view>
                    </view>
                    <view class="bottomArea">
                        <view class="infname">{{item.name}}</view>
                        <view class="infstate">{{item.state}}</view>
                        <view class="infdetail" id="{{item.id}}" bindtap="toEdit">修改</view>
                    </view>
                </view>
            </view>
        </view>
    </view>
</view>