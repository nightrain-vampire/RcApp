<page-meta page-style="overflow: {{visible ? 'visible' : 'hidden'}}">
    <view class="main">
        <loading wx-if="{{loading}}" />
        
        <view class="head-bg">
            <view class="searchbar">
                <input placeholder="搜索（搜索关键词查找候选人）" model:value = "{{searchkey}}" bindinput="searchInput"></input>
                <image src="../../static/search.png" class="searchicon" bindtap="search" ></image>
            </view>
            <view class="container">
                <view wx:for="{{cardData}}" wx:for-index="cid">
                    <view class="card-info">
                        <view class="picArea">
                            <swiper class="sitem" current="{{currentIndex[cid]}}" bindanimationfinish="changeFinish" id="{{cid}}">
                                <swiper-item wx:for="{{item.img}}" wx:for-item="img" catchtouchmove="stopTouchMove">
                                    <image src='{{img}}' mode="aspectFill" style="height: 100%; width: 100%;"></image>
                                </swiper-item>
                            </swiper>
                            <view class="smove">
                                <view class="controlview">
                                    <image wx:if="{{LeftShow[cid]}}" src="../../static/left.png" class="controlimg" id="{{cid}}" bindtap="toLeft"></image>
                                </view>
                                <view class="controlview">
                                    <image wx:if="{{RightShow[cid]}}" src="../../static/right.png" class="controlimg" id="{{cid}}" bindtap="toRight"></image>
                                </view>
                            </view>
                            <view class="inf">
                                <view class="votes">{{item.votes}}</view>
                                <view class="votebutt" id="{{cid}}" bindtap="vote">投票</view>
                            </view>
                        </view>
                        <view class="infArea">
                            <view class="infname">{{item.name}}</view>
                            <view class="infdetail" id="{{cid}}" bindtap="openMask">详情</view>
                        </view>
                    </view>
                </view>
            </view>
            <view class="mask" wx:if="{{maskflag}}" bindtap="closeMask">
                <view class="detail">
                    <view class="tophalf">
                        <view class="depic">
                            <swiper style="width: 100%; height: 100%; padding-bottom: 10rpx;" indicator-dots="true" autoplay="true" interval="3500" circular="true">
                                <swiper-item wx:for="{{detailData}}">
                                    <image src="{{item}}" mode="aspectFill" style="height: 100%; width: 100%;"></image>
                                </swiper-item>
                            </swiper>
                        </view>
                        <view style="font-size: large; font-weight: 600;">{{name}}</view>
                        <view style="word-break: keep-all; word-wrap: break-word; white-space: pre-line; font-weight: 300;">{{intro}}</view>
                    </view>
                    <view class="divLine"></view>
                    <view class="divLine2"></view>
                    <view class="bottomhalf">
                        <view style="font-size: medium; font-weight: 600;">推荐理由</view>
                        <view style="word-break: keep-all; word-wrap: break-word; white-space: pre-line; font-weight: 300;">{{reason}}</view>
                    </view>
                </view>
            </view>
        </view>
    </view>
</page-meta>