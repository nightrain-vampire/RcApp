
.card-info {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    justify-content: center;
    text-align: center;
    align-items: center;
    position: relative;
    background-color: #FdFdFd;
    width: 100%;
    height: 550rpx;
    border-radius:15rpx;
    box-shadow: 0px 0px 8rpx #888888;
    font-size: 26rpx;
}

.searchbar{
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx 0 28rpx 20rpx;
    border-bottom: 2rpx solid #dbdbdb;
    font-size: 34rpx;
  }

.img{
    width: 100%;
}