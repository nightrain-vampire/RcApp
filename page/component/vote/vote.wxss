.card-info {
    flex-shrink: 0;
    box-sizing: border-box;
    padding: 10px;
    width: 350rpx;
    height: 600rpx;
    justify-content: center;
    text-align: center;
    align-items: center;
    /* position: relative; */
    margin-left: 7px;
    margin-bottom: 10px;
    background-color: #FdFdFd;
    border-radius:15rpx;
    box-shadow: 0px 0px 8rpx #888888;
    font-size: 26rpx;
}

.container{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.picArea{
    height: 300rpx;
}

.divLine{
    background: cadetblue;
    width: 100%;
    height: 5rpx;
}

.infArea{
    padding: 10px;
}