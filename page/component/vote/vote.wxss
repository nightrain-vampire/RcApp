.card-info {
    flex-shrink: 0;
    box-sizing: border-box;
    width: 675rpx;
    height: 500rpx;
    margin-bottom: 20px;
    background-color: #FdFdFd;
    /* border-radius:15rpx; */
    box-shadow: 0px 0px 8rpx #888888;
    font-size: 26rpx;
}

.container{
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    align-items: center;
}

.picArea{
    position: relative;
    width: auto;
    height: 420rpx;
}

.inf {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 13rpx;
    transform: translateY(-110rpx); 
}

.votes {
    color: white;
    font-size: xx-large;
    font-weight: 450;
}

.votebutt {
    border: 4rpx solid #c70b1a;
    border-radius: 0.8em;
    padding: 0rpx 13rpx;
    font-size: large;
    font-weight: 600;
    color: white;
    background-color: #c70b1a;
    display: flex;
    align-items: center;
    justify-content: center;
}

.smove {
    height: 0;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 0 25rpx;
    transform: translateY(-260rpx);
}

.controlview {
    width: 80rpx;
    height: 80rpx;
}

.controlimg {
    width: 100%;
    height: 100%;
}

.sitem {
    height: 100%;
}

.infArea{
    padding: 20rpx;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.infname {
    float: left;
}

.infdetail {
    border: 4rpx solid darkgray;
    border-radius: 0.8em;
    padding: 10rpx 15rpx;
    font-size: small;
    color: darkgray;
    transform: translateY(-12rpx);
}

.searchbar {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 25px;
    padding-top: 25px;
}

.searchicon {
    width: 70rpx;
    height: 70rpx;
    float: right;
    transform: translateX(-45rpx);
}

input {
    font-size: 30rpx;
    text-align: center;
    border: 1rpx solid #D5D5D5;
    background-color: white;
    border-radius: 40rpx;
    width: 675rpx;
    height: 75rpx;
    float: left;
    transform: translateX(5%);
}

.mask {
    width: 100%;
    height: 100%;
    background: rgba(128, 128, 128, 0.5);
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
}

.detail {
    width: 94%;
    height: 60%;
    position: fixed;
    background-color: white;
    left: 3%;
    top: 20%;
    padding: 40rpx;
    overflow: scroll;
}

.tophalf {
    height: 75%;
}

.bottomhalf {
    height: 20%;
}

.divLine {
    border: 0.01rpx solid #b2d2f7;
    margin: 1.5% 2% 1% 2%;
    width: 70%;
}

.divLine2 {
    border: 0.01rpx solid #b2d2f7;
    margin: 0rpx 2% 1.5% 2%;
    width: 70%;
    transform: translateX(30%);
}

.depic {
    width: 100%;
    height: 75%;
}

.main {
    width: 100%;
    min-height: 100vh;
    background-size: cover;
    background-repeat: repeat;
    background-color: #111125;
    background-image: url('data:image/png;base64,');
}